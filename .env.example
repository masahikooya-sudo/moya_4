# Google Cloud Console(APIとサービス > 認証情報)で発行したOAuthクライアント
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx

# ログインを許可するGoogle Workspaceドメイン
GOOGLE_ALLOWED_DOMAIN=pdpro.jp

# セッションCookieの署名鍵。openssl rand -hex 32 等で生成した値を設定する
SESSION_SECRET_KEY=

# このファイルを .env にコピーして値を設定してください(.env はgit管理対象外)。
# docker compose up はカレントディレクトリの .env を自動的に読み込みます。
